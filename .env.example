# Copy this file to `.env` (which is gitignored) and adjust as needed.
# The real `.env` must never be committed — it may hold secrets.

# Which CRS approach serves /chat: echo | rag | multi_agent
# (only "echo" is implemented today; the others land in later phases)
CRS_APPROACH=echo

# OpenAI model name (gpt-4o-mini is cheap and good for this)
CRS_LLM_MODEL=gpt-4o-mini

# Retrieval depth for RAG: how many movie documents to pull back
CRS_TOP_K=5

# LLM API key. Leave blank to run on the offline FakeLLM; set it and the app
# switches to real generation. Works with OpenAI OR any OpenAI-compatible
# provider (see CRS_LLM_BASE_URL below).
CRS_LLM_API_KEY=

# Optional OpenAI-compatible base URL. Leave blank for real OpenAI. For a FREE
# provider, set this and CRS_LLM_MODEL accordingly, e.g. Groq:
#   CRS_LLM_BASE_URL=https://api.groq.com/openai/v1
#   CRS_LLM_MODEL=llama-3.3-70b-versatile
CRS_LLM_BASE_URL=

# TMDB API key (free: themoviedb.org -> Settings -> API). Used by
# `python -m data.enrich` to fetch movie plots/genres. Blank -> title-only.
CRS_TMDB_API_KEY=
